# Go_Repireo People - Environment Variables Example
# Duplicate this file as .env.local for local development.

# Supabase Public Configuration (Accessible to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Server-Only Configuration (NEVER expose to browser / client bundles)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Application URL (Used for generating absolute QR verification URLs)
# Local: http://localhost:3000
# Production: https://gorepireo.in or https://your-deployment.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
